# Copie para .env na raiz (docker compose) e para backend/.env e frontend/.env.local conforme o README.
# NÃO versione arquivos .env reais.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=checklist
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=checklist

# --- backend/.env ---
DATABASE_URL=postgresql://checklist:troque-esta-senha@localhost:5432/checklist?schema=public
# Banco separado, usado apenas pelos testes de integração (será LIMPO a cada execução!)
DATABASE_URL_TEST=postgresql://checklist:troque-esta-senha@localhost:5432/checklist_test?schema=public
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
# Opcional: caminho do Chrome/Edge instalado (útil no Windows se não usar "playwright install chromium")
CHROMIUM_PATH=
# Opcional: caminho do logotipo Nissan (PNG/JPG/SVG). Padrão: backend/assets/nissan-logo.png
LOGO_PATH=
# Usuário administrador criado pelo seed
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha-agora

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:3001
