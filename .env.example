# Copie para ".env" na raiz do projeto (usado pelo Next.js, Prisma e docker compose).
# NÃO versione o arquivo .env real.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=checklist
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=checklist

# --- Aplicação ---
DATABASE_URL=postgresql://checklist:troque-esta-senha@localhost:5432/checklist?schema=public
# Banco separado usado apenas pelos testes de integração (será LIMPO a cada teste!). O nome DEVE terminar em _test.
DATABASE_URL_TEST=postgresql://checklist:troque-esta-senha@localhost:5432/checklist_test?schema=public
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h
APP_TIMEZONE=America/Sao_Paulo
# Opcional: Chrome/Edge instalado (alternativa ao "npm run browsers:install"). Ex. Edge no Windows:
# CHROMIUM_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
CHROMIUM_PATH=
# Opcional: caminho do logotipo (PNG/JPG/SVG). Padrão: assets/nissan-logo.png
LOGO_PATH=

# --- Usuário administrador criado pelo seed (npm run db:seed) ---
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha-agora
